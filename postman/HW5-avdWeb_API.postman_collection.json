            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"สมชาย\",\n  \"last_name\": \"ใจดี\",\n  \"phone\": \"0812345678\",\n  \"email\": \"somchai@example.com\",\n  \"address\": \"หอพักริมบึง ห้อง 101\",\n  \"latitude\": 16.2465,\n  \"longitude\": 103.2505\n}",
